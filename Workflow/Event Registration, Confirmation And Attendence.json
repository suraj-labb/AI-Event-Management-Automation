    {
      "parameters": {
        "sendTo": "={{ $json[\"Email Address\"] }}",
        "subject": "Registration Successful - Your QR Code",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n</head>\n\n<body style=\"font-family:Arial,Helvetica,sans-serif;background:#f4f4f4;margin:0;padding:20px;\">\n\n<table width=\"650\" align=\"center\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;border-radius:8px;padding:30px;\">\n\n<tr>\n<td>\n\n<h2 style=\"color:#0B5ED7;text-align:center;\">\n🎉 Registration Confirmed\n</h2>\n\n<p>Dear <strong>{{$json[\"Full Name\"]}}</strong>,</p>\n\n<p>\nThank you for registering for our event. Your registration has been successfully confirmed.\nPlease find your registration details below.\n</p>\n\n<hr>\n\n<h3 style=\"color:#0B5ED7;\">Participant Details</h3>\n\n<table cellpadding=\"8\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:collapse;\">\n\n<tr style=\"background:#f8f9fa;\">\n<td><strong>Participant Name</strong></td>\n<td>{{$json[\"Full Name\"]}}</td>\n</tr>\n\n<tr>\n<td><strong>Email Address</strong></td>\n<td>{{$json[\"Email Address\"]}}</td>\n</tr>\n\n<tr style=\"background:#f8f9fa;\">\n<td><strong>Participant ID</strong></td>\n<td>{{$json.participantId}}</td>\n</tr>\n\n<tr>\n<td><strong>Preferred AI Topic(s)</strong></td>\n<td> {{ $json[\"Preferred AI Topics (Select one or more)\"] }}</td>\n</tr>\n\n<tr style=\"background:#f8f9fa;\">\n<td><strong>Event Date</strong></td>\n<td>30 August 2026</td>\n</tr>\n\n<tr>\n<td><strong>Reporting Time</strong></td>\n<td>09:30 AM</td>\n</tr>\n\n<tr style=\"background:#f8f9fa;\">\n<td><strong>Venue</strong></td>\n<td>Amity University, Patna</td>\n</tr>\n\n</table>\n\n<br>\n\n<h3 style=\"color:#0B5ED7;\">Your Event QR Code</h3>\n\n<p>Please present the following QR Code at the registration desk during check-in.</p>\n\n<div style=\"text-align:center;\">\n<img src=\"https://api.qrserver.com/v1/create-qr-code/?size=250x250&data={{$json.participantId}}\" alt=\"QR Code\">\n</div>\n\n<br>\n\n<div style=\"background:#F8F9FA;padding:15px;border-left:4px solid #0B5ED7;\">\n\n<b>Important Instructions</b>\n\n<ul>\n<li>Please arrive at least <strong>30 minutes before</strong> the event begins.</li>\n<li>Carry a valid College/Student ID.</li>\n<li>Show this email or your Participant ID during check-in.</li>\n<li>Keep your QR Code safe for event entry.</li>\n</ul>\n\n</div>\n\n<br>\n\n<p>\nWe look forward to welcoming you to the event.\n</p>\n\n<p>\nBest Regards,<br><br>\n\n<b>Event Organizing Committee</b><br>\nAMITY UNIVERSITY, Patna\n</p>\n\n<hr>\n\n<p style=\"font-size:12px;color:#888888;text-align:center;\">\nThis is an automated email. Please do not reply to this message.\n</p>\n\n</td>\n</tr>\n\n</table>\n\n</body>\n</html>",
        "options": {}
      },
